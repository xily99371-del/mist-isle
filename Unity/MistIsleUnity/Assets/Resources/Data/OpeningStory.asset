%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a75e4c6ba34f4f845b3b193d528f6fb7, type: 3}
  m_Name: OpeningStory
  m_EditorClassIdentifier: MistIsle.Runtime::MistIsle.Runtime.OpeningStory
  beats:
  - id: arrival
    lines:
    - speakerId: narrator
      text: "\u5C0F\u8247\u7EC8\u4E8E\u9760\u4E0A\u6808\u6865\u3002\u4E00\u8DEF\u8FFD\u968F\u7684\u706F\u5854\u5149\u8292\uFF0C\u5374\u5728\u96FE\u4E2D\u7184\u706D\u4E86\u3002\u6D77\u5CB8\u4E0A\uFF0C\u53EA\u6709\u4E00\u7C07\u7BDD\u706B\u8FD8\u4EAE\u7740\u3002"
    - speakerId: traveler
      text: "\u822A\u56FE\u4E0A\u7684\u5C9B\uFF0C\u539F\u6765\u771F\u7684\u5728\u8FD9\u91CC\u2026\u2026\u5148\u627E\u4EBA\u95EE\u95EE\u706F\u5854\u7684\u4E8B\u5427\u3002"
    - speakerId: watcher
      text: "\u6808\u6865\u90A3\u8FB9\u7684\u65C5\u4EBA\uFF01\u6162\u4E9B\u8D70\uFF0C\u6E7F\u6728\u677F\u53EF\u4E0D\u8BA4\u751F\u3002\u6CBF\u706F\u8D70\u8FC7\u6765\uFF0C\u5C4B\u524D\u6709\u5E72\u6BDB\u5DFE\u3002"
  - id: watcher
    lines:
    - speakerId: watcher
      text: "\u6211\u662F Watcher\u3002\u8425\u5730\u91CC\u7684\u4EBA\u548C\u4F19\u4F34\u7D2F\u4E86\uFF0C\u90FD\u4F1A\u56DE\u6765\u627E\u6211\u3002\u4F60\u7684\u624B\u51BB\u5F97\u53D1\u767D\uFF0C\u5148\u9760\u8FD1\u706B\u6696\u4E00\u6696\u3002"
    - speakerId: traveler
      text: "\u8C22\u8C22\u3002\u6211\u5FAA\u7740\u706F\u5854\u7684\u5149\u6765\u7684\uFF0C\u53EF\u521A\u624D\u5B83\u7A81\u7136\u6697\u4E0B\u53BB\u4E86\u3002"
    - speakerId: watcher
      text: "\u5C9B\u4E0A\u7684\u96FE\u8D8A\u6765\u8D8A\u6DF1\uFF0C\u72EC\u81EA\u5F80\u91CC\u8D70\u53EF\u4E0D\u6210\u3002\u90A3\u8FB9\u6234\u62A4\u76EE\u955C\u7684\u59D1\u5A18\u53EB\u62FE\u5149\uFF0C\u5979\u6B63\u7167\u770B\u4E09\u4F4D\u5C0F\u5BB6\u4F19\u3002\u53BB\u548C\u5979\u6253\u58F0\u62DB\u547C\u5427\u3002"
  - id: guide
    lines:
    - speakerId: shiguang
      text: "\u521A\u624D\u5728\u7801\u5934\u7684\u662F\u4F60\u5427\uFF1F\u6211\u662F\u62FE\u5149\u3002\u522B\u62C5\u5FC3\uFF0CWatcher
        \u7684\u706B\u4ECE\u6765\u4E0D\u4F1A\u7184\u3002"
    - speakerId: traveler
      text: "\u4ED6\u8BF4\uFF0C\u4F60\u80FD\u544A\u8BC9\u6211\u600E\u6837\u5728\u5C9B\u4E0A\u65C5\u884C\u3002"
    - speakerId: shiguang
      text: "\u7B2C\u4E00\u4EF6\u4E8B\uFF0C\u662F\u627E\u4E00\u4F4D\u613F\u610F\u540C\u884C\u7684\u4F19\u4F34\u3002\u8FD9\u4E09\u4F4D\u4E00\u76F4\u4F4F\u5728\u8425\u5730\uFF0C\u5404\u6709\u5404\u7684\u813E\u6C14\u3002\u4F60\u9760\u8FD1\u770B\u770B\uFF0C\u522B\u6025\u7740\u51B3\u5B9A\u3002"
  - id: meet-moss-lumi
    lines:
    - speakerId: narrator
      text: "\u82D4\u85D3\u7075\u628A\u4E00\u7247\u5E26\u7740\u9732\u73E0\u7684\u53F6\u5B50\u9012\u5230\u4F60\u9762\u524D\uFF0C\u5934\u9876\u7684\u5C0F\u82B1\u968F\u7740\u6D77\u98CE\u8F7B\u8F7B\u6447\u6643\u3002"
    - speakerId: shiguang
      text: "\u5B83\u603B\u5148\u7167\u987E\u522B\u4EBA\u3002\u85E4\u5149\u80FD\u5B89\u629A\u53D7\u60CA\u7684\u751F\u7075\uFF0C\u4E5F\u80FD\u8BA9\u67AF\u840E\u7684\u85E4\u8513\u91CD\u65B0\u751F\u957F\u3002\u4F60\u60F3\u5E26\u8FD9\u6837\u7684\u4F19\u4F34\u4E00\u8D77\u8D70\u5417\uFF1F"
  - id: meet-moatail
    lines:
    - speakerId: narrator
      text: "\u6CAB\u5C3E\u517D\u4ECE\u6C34\u7897\u8FB9\u8DD1\u6765\u3002\u5C3E\u5C16\u6EDA\u7740\u4E00\u9897\u5C0F\u6C34\u73E0\uFF0C\u505C\u5728\u4F60\u7684\u9774\u8FB9\uFF0C\u5374\u6CA1\u6709\u5F04\u6E7F\u5B83\u3002"
    - speakerId: shiguang
      text: "\u5B83\u559C\u6B22\u65B0\u9C9C\u4E8B\uFF0C\u5374\u603B\u8BB0\u5F97\u56DE\u5934\u627E\u540C\u4F34\u3002\u6F6E\u6C50\u80FD\u7F13\u548C\u4F24\u52BF\uFF0C\u4E5F\u80FD\u5524\u9192\u505C\u6EDE\u7684\u6C34\u8DEF\u3002\u4F60\u4EEC\u4E5F\u8BB8\u4F1A\u5F88\u5408\u5F97\u6765\u3002"
  - id: meet-crystal-gecko
    lines:
    - speakerId: narrator
      text: "\u9E23\u6676\u8725\u6B6A\u7740\u8111\u888B\u542C\u4E86\u542C\u4F60\u7684\u811A\u6B65\u3002\u80CC\u4E0A\u7684\u6676\u4F53\u54CD\u8D77\u4E00\u58F0\u6E05\u8106\u7684\u56DE\u97F3\uFF0C\u50CF\u662F\u5728\u56DE\u7B54\u3002"
    - speakerId: shiguang
      text: "\u5B83\u8BA4\u5F97\u575A\u5B9A\u7684\u811A\u6B65\u3002\u6676\u80FD\u64C5\u957F\u96C6\u4E2D\u529B\u91CF\uFF0C\u4E5F\u80FD\u8BA9\u53E4\u8001\u7684\u5BFC\u4F53\u91CD\u65B0\u5171\u9E23\u3002\u53EA\u662F\uFF0C\u522B\u5FD8\u4E86\u5728\u51B2\u5411\u524D\u65B9\u65F6\u7167\u987E\u5F7C\u6B64\u3002"
  - id: bond-moss-lumi
    lines:
    - speakerId: traveler
      text: "\u6211\u8FD8\u4E0D\u77E5\u9053\u524D\u9762\u6709\u4EC0\u4E48\u3002\u4F60\u613F\u610F\u966A\u6211\u4E00\u8D77\u627E\u7B54\u6848\u5417\uFF1F"
    - speakerId: narrator
      text: "\u82D4\u85D3\u7075\u8F7B\u8F7B\u8D34\u4F4F\u4F60\u7684\u624B\u5FC3\u3002\u53F6\u7247\u4E0B\u7684\u5FAE\u5149\u6696\u4E86\u8D77\u6765\uFF0C\u5B83\u7ED5\u8FC7\u62FE\u5149\uFF0C\u7AD9\u5230\u4E86\u4F60\u7684\u8EAB\u65C1\u3002"
    - speakerId: shiguang
      text: "\u770B\u6765\u5B83\u5DF2\u7ECF\u51B3\u5B9A\u4E86\u3002\u8BB0\u4F4F\uFF0C\u540C\u884C\u662F\u5F7C\u6B64\u7684\u9009\u62E9\uFF0C\u4E0D\u662F\u4E00\u53E5\u547D\u4EE4\u3002"
  - id: bond-moatail
    lines:
    - speakerId: traveler
      text: "\u524D\u9762\u7684\u8DEF\uFF0C\u4E5F\u4F1A\u6709\u50CF\u4F60\u8FD9\u6837\u7684\u65B0\u670B\u53CB\u5417\uFF1F"
    - speakerId: narrator
      text: "\u6CAB\u5C3E\u517D\u6296\u5F00\u5C3E\u5C16\u7684\u6C34\u73E0\uFF0C\u7ED5\u7740\u4F60\u8DD1\u4E86\u4E00\u5708\uFF0C\u53C8\u8BA4\u771F\u5730\u56DE\u5230\u4F60\u8EAB\u65C1\u3002\u5B83\u5728\u7B49\u4F60\u8FC8\u51FA\u7B2C\u4E00\u6B65\u3002"
    - speakerId: shiguang
      text: "\u5B83\u628A\u4F60\u5F53\u4F5C\u540C\u884C\u7684\u4EBA\u4E86\u3002\u8D70\u8FDC\u65F6\uFF0C\u8BB0\u5F97\u50CF\u5B83\u4E00\u6837\u56DE\u5934\u770B\u770B\u3002"
  - id: bond-crystal-gecko
    lines:
    - speakerId: traveler
      text: "\u5982\u679C\u8DEF\u88AB\u96FE\u6321\u4F4F\u4E86\uFF0C\u6211\u4EEC\u5C31\u4E00\u8D77\u628A\u5B83\u627E\u51FA\u6765\uFF0C\u597D\u5417\uFF1F"
    - speakerId: narrator
      text: "\u9E23\u6676\u8725\u7528\u524D\u722A\u78B0\u4E86\u78B0\u4F60\u7684\u9774\u5C16\u3002\u6676\u4F53\u53D1\u51FA\u660E\u4EAE\u7684\u8F7B\u54CD\uFF0C\u5B83\u633A\u8D77\u80F8\u53E3\uFF0C\u5B88\u5728\u4F60\u8EAB\u4FA7\u3002"
    - speakerId: shiguang
      text: "\u5B83\u56DE\u5E94\u4F60\u4E86\u3002\u8BA9\u8FD9\u4EFD\u4FE1\u4EFB\u6162\u6162\u957F\u5927\uFF0C\u8FDC\u6BD4\u50AC\u5B83\u53D8\u5F3A\u66F4\u91CD\u8981\u3002"
  - id: gather
    lines:
    - speakerId: shiguang
      text: "\u6B63\u597D\uFF0C\u6211\u6709\u4EF6\u4E8B\u60F3\u8BF7\u4F60\u548C{partner}\u5E2E\u5FD9\u3002\u9000\u6F6E\u65F6\uFF0C\u4E00\u53EA\u6F6E\u58F3\u87F9\u88AB\u65E7\u6E14\u7EBF\u56F0\u5728\u6D77\u8FB9\u3002\u6211\u89E3\u5F00\u4E86\u7EBF\uFF0C\u53EF\u5B83\u8FD8\u5728\u5BB3\u6015\uFF0C\u4E0D\u80AF\u79BB\u5F00\u3002"
    - speakerId: traveler
      text: "\u6211\u4EEC\u80FD\u505A\u4E9B\u4EC0\u4E48\uFF1F"
    - speakerId: shiguang
      text: "\u5148\u5E26\u70B9\u5403\u7684\u3002\u5C0F\u9662\u8FB9\u7684\u91CE\u8393\u6210\u719F\u4E86\uFF0C\u6811\u4E0B\u7684\u9732\u6C34\u4E5F\u5F88\u5E72\u51C0\u3002\u6458\u4E9B\u56DE\u6765\uFF0C\u6211\u6559\u4F60\u5728\u7BDD\u706B\u65C1\u505A\u8393\u679C\u56E2\u3002"
  - id: ingredients
    lines:
    - speakerId: shiguang
      text: "\u8FD9\u4E9B\u5C31\u591F\u4E86\u3002\u53BB\u7BDD\u706B\u65C1\uFF0C\u628A\u4E24\u4EFD\u91CE\u8393\u548C\u4E00\u4EFD\u9732\u6C34\u62CC\u6210\u8393\u679C\u56E2\u3002\u9999\u5473\u4F1A\u8BA9\u5B83\u77E5\u9053\uFF0C\u6211\u4EEC\u4E0D\u662F\u6765\u4F24\u5BB3\u5B83\u7684\u3002"
  - id: food-ready
    lines:
    - speakerId: shiguang
      text: "\u95FB\u8D77\u6765\u5F88\u597D\uFF01\u6211\u66FF\u4F60\u88C5\u4E86\u4E00\u679A\u5171\u9E23\u6355\u83B7\u5668\uFF0C\u4E0D\u8FC7\u5148\u522B\u6025\u7740\u7528\u3002\u8981\u5148\u542C\u61C2\u5B83\u7684\u56DE\u5E94\u3002"
    - speakerId: traveler
      text: "{partner}\uFF0C\u6211\u4EEC\u4E00\u8D77\u53BB\u770B\u770B\u90A3\u4F4D\u6D77\u8FB9\u7684\u670B\u53CB\u5427\u3002"
    - speakerId: shiguang
      text: "\u8DDF\u6211\u6765\u3002\u6CBF\u7740\u4E1C\u4FA7\u7684\u5C0F\u8DEF\u8D70\uFF0C\u522B\u8E29\u5230\u521A\u88AB\u6F6E\u6C34\u51B2\u677E\u7684\u77F3\u5934\u3002"
  - id: crab
    lines:
    - speakerId: narrator
      text: "\u65E7\u6E14\u7EBF\u6563\u5728\u7901\u77F3\u65C1\u3002\u6F6E\u58F3\u87F9\u89C1\u5230\u811A\u6B65\u58F0\uFF0C\u7ACB\u523B\u4E3E\u8D77\u94B3\u5B50\uFF0C\u62A4\u4F4F\u53D7\u4F24\u7684\u811A\u3002"
    - speakerId: shiguang
      text: "\u522B\u76F4\u63A5\u4F38\u624B\u3002\u8BA9{partner}\u8F7B\u8F7B\u7275\u5236\u5B83\u4E00\u4E0B\uFF0C\u7B49\u5B83\u4E0D\u518D\u4E71\u649E\uFF0C\u518D\u628A\u98DF\u7269\u9012\u8FC7\u53BB\u3002\u4F60\u4E5F\u53EF\u4EE5\u5728\u5B83\u5E73\u9759\u540E\u8BD5\u7740\u5EFA\u7ACB\u5171\u9E23\u3002"
    - speakerId: traveler
      text: "\u6211\u4EEC\u6162\u6162\u6765\u3002\u8FD9\u91CC\u5DF2\u7ECF\u6CA1\u6709\u6E14\u7EBF\u4E86\uFF0C\u4E5F\u6CA1\u6709\u4EBA\u8981\u4F24\u5BB3\u4F60\u3002"
  - id: captured
    lines:
    - speakerId: narrator
      text: "\u6F6E\u58F3\u87F9\u7EC8\u4E8E\u653E\u4E0B\u94B3\u5B50\u3002\u5B83\u5C0F\u5FC3\u5730\u78B0\u4E86\u78B0\u4F60\u7684\u624B\uFF0C\u968F\u540E\u8DDF\u4E0A\u4E86{partner}\u7684\u811A\u6B65\u3002"
    - speakerId: shiguang
      text: "\u770B\uFF0C\u662F\u5B83\u81EA\u5DF1\u613F\u610F\u8D70\u8FC7\u6765\u7684\u3002\u6355\u83B7\u4E0D\u662F\u628A\u751F\u7075\u5173\u4F4F\uFF0C\u800C\u662F\u8BA9\u5B83\u76F8\u4FE1\uFF0C\u53EF\u4EE5\u628A\u80CC\u540E\u4EA4\u7ED9\u4F60\u3002"
    - speakerId: traveler
      text: "\u5B83\u7684\u811A\u8FD8\u5728\u75BC\u5427\u3002\u6211\u4EEC\u5148\u56DE\u53BB\u627E
        Watcher\u3002"
  - id: report
    lines:
    - speakerId: watcher
      text: "\u505A\u5F97\u4E0D\u9519\u3002\u6765\uFF0C\u628A\u5B83\u653E\u5728\u5E72\u51C0\u7684\u57AB\u5B50\u4E0A\u3002\u5C0F\u4F24\u517B\u4E00\u517B\u5C31\u597D\uFF0C\u4F60\u4EEC\u4E5F\u4E00\u8D77\u4F11\u606F\u4F1A\u513F\u3002"
    - speakerId: shiguang
      text: "\u6709\u6211\u6559\u4F60\u8BA4\u8BC6\u65B0\u4F19\u4F34\uFF0C\u6709 Watcher
        \u5B88\u7740\u5F52\u9014\u3002\u63A5\u4E0B\u6765\uFF0C\u5C31\u8F6E\u5230\u4F60\u81EA\u5DF1\u542C\u542C\u96FE\u5C7F\u7684\u58F0\u97F3\u4E86\u3002"
    - speakerId: traveler
      text: "\u90A3\u5C31\u4ECE\u706F\u5854\u7184\u706D\u7684\u539F\u56E0\u5F00\u59CB\u5427\u3002\u8D70\u5427\uFF0C\u4F19\u4F34\u4EEC\u3002"
