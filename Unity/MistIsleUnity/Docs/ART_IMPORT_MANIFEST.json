  "original_art_policy": "Original user boards and frozen course-edition assets were copied without modification. Reference boards are outside Resources and are never used as runtime sprite sheets.",
  "review_status": "Playable integration candidates. Approved designs remain canonical; AI extraction outputs require final pixel/style review. New wild-07 through wild-12 are newly authorized original candidates, not user-approved final character designs.",
  "production_limitations": [
    "Creature and guardian artwork currently consists of one static image each; directional, idle, attack, capture and evolution animations are incomplete.",
    "Imagegen extraction is not pixel-identical lossless extraction; do not describe the resulting candidate cutouts as final approved production pixels.",
    "Traveler movement currently reuses the frozen edition's existing transparent four-direction sprites; needs full accessory-by-accessory comparison with the newer art bible.",
    "Only authorized-source short sound effects were copied. The course edition's commercial music files were excluded from the Unity content copy.",
    "No Unity editor, test runner, or build was run by the art task. Main integration agent owns actual import/build/play verification."
  ],
  "import_settings": {
    "pixels_per_unit": 64,
    "filter": "Point",
    "mipmaps": false,
    "compression": "Uncompressed",
    "wrap": "Clamp",
    "pivot_actors_props_creatures": [
      0.5,
      0
    ],
    "pivot_ground": [
      0.5,
      0.5
    ],
    "alpha_is_transparency": true,
    "npot_scale": "None"
  },
  "deterministic_processing": "Unity Texture2D.GetPixels crops independent PNG resources. For already-transparent cutouts, rectangular bounds ignore alpha values below 16/255 when locating the crop; retained pixels are copied unchanged. There is no scripted recoloring, painting, background segmentation, or invented frame generation.",
